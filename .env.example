# Optional. Leave empty for dry-run; never commit a real value.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

# Required for POST /api/v1/complete. Generate at least 32 random characters.
# The browser UI uses a separate HttpOnly session cookie.
PII_AIRLOCK_API_TOKEN=

# opaque is the privacy-preserving default. typed reveals entity type and
# repeated-value linkage to the provider and is intended for diagnostics only.
PII_AIRLOCK_TOKEN_MODE=opaque

# Optional persistent signing key for review receipts. Without it, receipts
# are verifiable only while the current process is alive.
PII_AIRLOCK_RECEIPT_KEY=
PII_AIRLOCK_BUILD_COMMIT=
